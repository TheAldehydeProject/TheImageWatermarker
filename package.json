{
  "name": "the-image-watermarker",
  "private": true,
  "version": "0.1.0",
  "description": "Compress, convert and watermark images entirely in your browser, with three separate tools.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:shared": "vitest run tests/engine tests/ui",
    "test:compress": "vitest run tests/compress",
    "test:convert": "vitest run tests/convert",
    "test:watermark": "vitest run tests/watermark",
    "test:e2e": "playwright test",
    "test:e2e:home": "playwright test e2e/home.spec.ts",
    "test:e2e:compress": "playwright test e2e/compress.spec.ts",
    "test:e2e:convert": "playwright test e2e/convert.spec.ts",
    "test:e2e:watermark": "playwright test e2e/watermark.spec.ts",
    "test:e2e:mobile": "playwright test e2e/mobile.spec.ts",
    "audit": "npm audit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/jxl": "^1.3.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/webp": "^1.5.0",
    "fflate": "^0.8.3",
    "libheif-js": "^1.23.2",
    "libraw-wasm": "^1.6.0",
    "opentype.js": "^2.0.0",
    "utif2": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.4",
    "@types/opentype.js": "^1.3.10",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.0",
    "gifenc": "^1.0.3",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
